{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.local/schemas/production-plan.schema.json",
  "title": "ORVYQ Canonical Production Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project_id", "fps", "width", "height", "full_frame_count", "full_duration_seconds", "proof_boundary_frame", "audio_mix_asset", "sections", "shots"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string"},
    "fps": {"enum": [24, 25, 30]},
    "width": {"type": "integer", "minimum": 1920},
    "height": {"type": "integer", "minimum": 1080},
    "full_frame_count": {"type": "integer", "minimum": 1},
    "full_duration_seconds": {"type": "number", "minimum": 60},
    "proof_boundary_frame": {"type": "integer", "minimum": 1},
    "audio_mix_asset": {"type": "string", "pattern": "^assets/audio/"},
    "sections": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["section_id", "title", "start_frame", "end_frame"]}},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["shot_id", "shot_type", "start_frame", "end_frame", "claim_ids", "editorial_purpose", "motif_id"], "properties": {"shot_id": {"type": "string"}, "shot_type": {"type": "string"}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 1}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "asset_ids": {"type": "array", "items": {"type": "string"}}, "editorial_purpose": {"type": "string", "minLength": 12}, "motif_id": {"type": "string"}, "captions_suppressed": {"type": "boolean"}}}}
  }
}
