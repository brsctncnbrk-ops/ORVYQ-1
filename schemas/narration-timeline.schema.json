{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.local/schemas/narration-timeline.schema.json",
  "title": "ORVYQ Narration Timeline",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project_id", "source_audio", "source_audio_sha256", "source_duration_seconds", "transformed_duration_seconds", "words", "editorial_pauses", "proof_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "source_audio": {"type": "string"},
    "source_audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "transformed_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "words": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text", "output_start", "output_end"], "properties": {"text": {"type": "string"}, "output_start": {"type": "number", "minimum": 0}, "output_end": {"type": "number", "exclusiveMinimum": 0}, "source_start": {"type": "number", "minimum": 0}, "source_end": {"type": "number", "exclusiveMinimum": 0}}}},
    "editorial_pauses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["pause_id", "source_time_seconds", "output_start_seconds", "duration_seconds"], "properties": {"pause_id": {"type": "string"}, "source_time_seconds": {"type": "number", "minimum": 0}, "output_start_seconds": {"type": "number", "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 1, "maximum": 12}, "output_end_seconds": {"type": "number"}, "editorial_function": {"type": "string"}, "visual_intent": {"type": "string"}, "captions_suppressed": {"type": "boolean"}}}},
    "proof_boundary": {"type": "object", "required": ["seconds", "frame", "final_word", "sentence_end", "paragraph_end", "shot_boundary"], "properties": {"seconds": {"type": "number", "minimum": 150}, "frame": {"type": "integer", "minimum": 1}, "final_word": {"type": "string"}, "sentence_end": {"const": true}, "paragraph_end": {"const": true}, "shot_boundary": {"const": true}}}
  }
}
