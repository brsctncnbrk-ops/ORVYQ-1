{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.local/schemas/evidence-registry.schema.json",
  "title": "ORVYQ Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["evidence_id", "evidence_type", "relative_path", "sha256", "byte_size", "source_url", "source_ids", "claim_ids", "provenance_mode", "caption", "license_or_basis"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Z0-9_\\-]+$"},
          "evidence_type": {"enum": ["primary_document", "official_figure", "official_screen", "official_article", "official_table", "primary_image_sequence"]},
          "relative_path": {"type": "string", "pattern": "^evidence/.+\\.(png|jpg|jpeg|webp|pdf)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1024},
          "source_url": {"type": "string", "format": "uri"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "provenance_mode": {"const": "official_primary_capture"},
          "caption": {"type": "string", "minLength": 8},
          "license_or_basis": {"type": "string", "minLength": 8},
          "page_number": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
