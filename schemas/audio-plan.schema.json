{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.local/schemas/audio-plan.schema.json",
  "title": "ORVYQ Audio Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project_id", "narration_asset", "music_assets", "music_cues", "ducking", "loudness", "output_asset"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string"},
    "narration_asset": {"type": "string"},
    "music_assets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "music_cues": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["cue_id", "state", "start_seconds", "end_seconds", "gain_db", "energy_start", "energy_end", "function", "transition_out"], "properties": {"cue_id": {"type": "string"}, "state": {"type": "string"}, "asset": {"type": "string"}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}, "source_offset_seconds": {"type": "number", "minimum": 0}, "gain_db": {"type": "number", "minimum": -32, "maximum": -8}, "energy_start": {"type": "number", "minimum": 0, "maximum": 1}, "energy_end": {"type": "number", "minimum": 0, "maximum": 1}, "function": {"type": "string"}, "transition_out": {"type": "string"}}}},
    "ducking": {"type": "object", "required": ["enabled", "threshold_db", "ratio", "attack_ms", "release_ms"], "properties": {"enabled": {"const": true}, "threshold_db": {"type": "number"}, "ratio": {"type": "number"}, "attack_ms": {"type": "number"}, "release_ms": {"type": "number"}}},
    "loudness": {"type": "object", "required": ["target_lufs", "true_peak_dbfs"], "properties": {"target_lufs": {"type": "number", "minimum": -18, "maximum": -14}, "true_peak_dbfs": {"type": "number", "minimum": -3, "maximum": -1}}},
    "output_asset": {"type": "string", "pattern": "^assets/audio/"}
  }
}
